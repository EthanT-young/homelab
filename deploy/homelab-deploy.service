[Unit]
Description=Sync /home/ethan/docker repos with GitHub main and apply changes
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ethan
Group=ethan
SupplementaryGroups=docker
Environment=HOME=/home/ethan
WorkingDirectory=/home/ethan/docker
ExecStart=/home/ethan/docker/deploy/deploy.sh
TimeoutStartSec=90min
