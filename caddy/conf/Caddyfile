ethantyoung.com, www.ethantyoung.com {
	# Code Visualizer app (code-visualizer repo), reached through its Unix socket.
	redir /projects/code-visualizer/app /projects/code-visualizer/app/
	handle_path /projects/code-visualizer/app/* {
		reverse_proxy unix//codeviz/codeviz.sock
	}

	# UNLV Enrollment Viewer (myUNLV-class-scraper repo). The trailing-slash
	# redirect matters: the page loads data/ and api/ with relative URLs.
	redir /projects/unlvEnrollmentViewer /projects/unlvEnrollmentViewer/ 308
	handle_path /projects/unlvEnrollmentViewer/* {
		encode zstd gzip
		reverse_proxy unlv-enrollment-viewer:8080
	}

	# Kibitz chess game review (kibitz-chess repo): static files served by its
	# own container. Its pages use relative URLs, hence the trailing-slash redirect.
	redir /projects/kibitz /projects/kibitz/ 308
	handle_path /projects/kibitz/* {
		# The app shares this origin with the other sites, so it may not install
		# a service worker (which could take over pages outside its folder).
		@sw header Service-Worker *
		respond @sw 403
		reverse_proxy kibitz:8080 {
			header_down -Service-Worker-Allowed
		}
	}

	handle {
		root * /site
		file_server {
			hide .*
		}
	}
}

status.ethantyoung.com {
	reverse_proxy uptime-kuma:3001
}

ai.ethantyoung.com {
	reverse_proxy open-webui:8080
}

convert.ethantyoung.com {
	reverse_proxy convert-app:80
}
